
def search_train(source, destination):
    if source and destination and source != destination:
        return "Train found successfully"
    return "Invalid journey details"


def book_ticket(passenger, age, seats):
    if passenger and 0 < age <= 120 and seats > 0:
        return "Ticket booked successfully"
    return "Booking failed"


def check_status(pnr):
    if pnr == 123456:
        return "Ticket confirmed"
    return "PNR not found"


print("RAILWAY RESERVATION - POSITIVE TESTING")

print("Test 1:", search_train("Chennai", "Bangalore"))
print("Test 2:", book_ticket("Arun", 25, 2))
print("Test 3:", check_status(123456))
