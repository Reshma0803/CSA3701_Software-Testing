
def withdraw(balance, amount):
    if amount <= 0:
        return "Invalid amount"
    elif amount > balance:
        return "Insufficient balance"
    else:
        return balance - amount


print("ATM SYSTEM TESTING")

print("Test 1:", withdraw(5000, 1000))
print("Test 2:", withdraw(5000, 6000))
print("Test 3:", withdraw(5000, -500))
print("Test 4:", withdraw(5000, 0))
print("Test 5:", withdraw(5000, 5000))
