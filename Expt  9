
def withdraw(balance, amount):
    if amount <= 0:
        return "Invalid withdrawal amount"
    elif amount > balance:
        return "Insufficient balance"
    else:
        return balance - amount


print("BANKING - NEGATIVE TESTING")

print("Test 1:", withdraw(5000, -1000))
print("Test 2:", withdraw(5000, 0))
print("Test 3:", withdraw(5000, 6000))
print("Test 4:", withdraw(5000, 10000))
