
import static org.junit.jupiter.api.Assertions.*;
import org.junit.jupiter.api.Test;

class GCDTest {

    int gcd(int a, int b) {
        a = Math.abs(a);
        b = Math.abs(b);

        while (b != 0) {
            int temp = b;
            b = a % b;
            a = temp;
        }

        return a;
    }

    @Test
    void testGCD() {
        assertEquals(5, gcd(10, 15));
        assertEquals(6, gcd(12, 18));
        assertEquals(1, gcd(7, 9));
        assertEquals(10, gcd(10, 0));
        assertEquals(5, gcd(-10, 15));
    }
}
